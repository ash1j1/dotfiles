" Turn syntax highlighting on.
syntax on

set nu
set mouse=a
set term=xterm-256color
set number
set relativenumber
set shiftwidth=4
set tabstop=4
set smartindent
set autoindent
set expandtab
set wrap
set linebreak
set incsearch
set ignorecase
set hlsearch
set hls!
set wildmenu
set noswapfile
set noerrorbells
